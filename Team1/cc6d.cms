#name("cc6") 
#autorun    
#includer("sub.xml") 

team(1,1,2)


//moiban()


batdau()

chonpb(4,6,1,1)


latthe(1,21)


GETSCREEN

// 1. Quét vùng 1 và gán giá trị 1/0 vào biến $th1
$th1 = 0
IF_PIXEL_IN(187, 129, 290, 323, 200)
   $th1 = 1
END_IF

// 2. Đến lượt mới thực hiện các hành động
IF_PIXEL_IN(239, 115, 239, 115, 15333887)

   // Trường hợp TH1: $bo = 0 VÀ $th1 = 1 (Tìm thấy màu tên boss)
   IF(($bo = 0) AND ($th1 = 1))
      PRINT("bo trai")
      KEYDOWN(75)
      WAITMS(200)
      KEYDOWN(75)
      WAITMS(500)
      KEYDOWN(75)
      WAITMS(500)
      KEYDOWN(75)
      WAITMS(200)

      KEYUP(75)
      WAITMS(500)
      KEYPRESS(#right)
      $bo = 1
   ELSE
      // Trường hợp 2: Boss bên TRÁI -> Bò sang PHẢI
      IF_PIXEL_IN(171, 129, 249, 323, 263872)
         PRINT("bosstrai bo phai")
         KEYDOWN(186)
         WAITMS(200)
         KEYDOWN(186)
         WAITMS(500)
         KEYDOWN(186)
         WAITMS(1000)
         KEYDOWN(186)
         WAITMS(200)

         KEYUP(186)
         WAITMS(500)
         KEYPRESS(#LEFT)
      ELSE
         // Trường hợp 3: Boss bên PHẢI -> Bò sang TRÁI
         IF_PIXEL_IN(250, 129, 328, 323, 263872)
            PRINT("bossphai phai bo trai")
            KEYDOWN(75)
            WAITMS(200)
            KEYDOWN(75)
            WAITMS(500)
            KEYDOWN(75)
            WAITMS(1000)
            KEYDOWN(75)
            WAITMS(200)

            KEYUP(75)
            WAITMS(500)
            KEYPRESS(#RIGHT)
         ELSE
            // Mặc định: Dame / Buff
            PRINT("dame")
            WAITMS(500)
            #include "ht\buff.txt"
            WAITMS(6000)
         END_IF
      END_IF
   END_IF

END_IF

WAITMS(50)



dame2()

	   

	   